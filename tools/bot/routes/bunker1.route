# Bunker 1, speedrun route. Agent: photograph the main screen (`auto`), copy the key with the analyser (collect the
# key tag 4, equip the case, fire it), then out through the room of pad 100 (ai_16 ends the mission there).
name bunker1
obj=0 auto
obj=1 collect obj 4
obj=1 equip keyanalysercase
obj=1 press z 4
obj=1 wait 60
obj=4 auto
auto
goto pad 100 80
exit
